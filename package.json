{
  "name": "cleanslate-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + TypeScript starter with a bundled FFmpeg binary.",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.alejandrojordan.cleanslate",
    "productName": "CleanSlate",
    "asar": {
      "smartUnpack": true,
      "unpack": [
        "**/node_modules/ffmpeg-static/**/*"
      ]
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/ffmpeg-static/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
