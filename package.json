{
  "name": "cleanslate-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "React + Electron + TypeScript starter with a bundled FFmpeg binary.",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "icon:mac": "electron scripts/build-mac-icon.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exiftool-vendored": "^39.0.1",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.alejandrojordan.cleanslate",
    "productName": "CleanSlate",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/exiftool-vendored.pl/**",
      "node_modules/exiftool-vendored.exe/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/exiftool-vendored/**/*",
      "node_modules/exiftool-vendored.pl/**/*",
      "node_modules/exiftool-vendored.exe/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "icons/cleanslate.icns",
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "icon": "icons/cleanslate.icns"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
